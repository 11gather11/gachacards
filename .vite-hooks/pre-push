#!/bin/sh
# push の前にリポジトリ全体を検査する。
#
# pre-commit の `vp staged` はステージされたファイルしか見ないので、
# 「触っていないファイルが他の変更で壊れた」状態はコミットを素通りする。
# ここで全体の整形・lint・型チェックと、本番ビルドが通ることまで確かめる。
#
# knip は「どこからも使われていない export」を見つける。型チェックは通るので
# lint では拾えず、放っておくと消し忘れたコードが残り続ける。
#
# テストは実物の Chromium を立ち上げるので 20 秒ほどかかる。それでもここで
# 走らせるのは、描画の指紋がリファクタの唯一の安全網だから。
#
# 急いで push したいときは `git push --no-verify` で飛ばせる。
set -e

vp check
vp run knip
vp test run
vp run build
